-- Hiển thị thời gian treo, FPS, và tốc độ mạng
local startTime = os.time()
local afkLabel, fpsLabel, pingLabel
local function setupTimeDisplay()
    local screenGui = Instance.new("ScreenGui", PlayerGui)
    screenGui.Name = "TimeDisplayGui"
    screenGui.IgnoreGuiInset = true

    -- Tạo TextLabel cho thời gian treo
    afkLabel = Instance.new("TextLabel", screenGui)
    afkLabel.Size = UDim2.new(0, 150, 0, 25)
    afkLabel.Position = UDim2.new(1, -160, 0, 10)
    afkLabel.BackgroundTransparency = 0.5
    afkLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    afkLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    afkLabel.TextScaled = true
    afkLabel.Text = "Thời gian treo: Đang tải..."
    afkLabel.BorderColor3 = Color3.fromRGB(255, 0, 0)
    afkLabel.BorderSizePixel = 2

    -- Tạo TextLabel cho FPS
    fpsLabel = Instance.new("TextLabel", screenGui)
    fpsLabel.Size = UDim2.new(0, 150, 0, 25)
    fpsLabel.Position = UDim2.new(1, -160, 0, 35)
    fpsLabel.BackgroundTransparency = 0.5
    fpsLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    fpsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    fpsLabel.TextScaled = true
    fpsLabel.Text = "FPS: Đang tải..."
    fpsLabel.BorderColor3 = Color3.fromRGB(255, 0, 0)
    fpsLabel.BorderSizePixel = 2

    -- Tạo TextLabel cho tốc độ mạng
    pingLabel = Instance.new("TextLabel", screenGui)
    pingLabel.Size = UDim2.new(0, 150, 0, 25)
    pingLabel.Position = UDim2.new(1, -160, 0, 60)
    pingLabel.BackgroundTransparency = 0.5
    pingLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    pingLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    pingLabel.TextScaled = true
    pingLabel.Text = "Ping: Đang tải..."
    pingLabel.BorderColor3 = Color3.fromRGB(255, 0, 0)
    pingLabel.BorderSizePixel = 2

    -- Cập nhật thời gian treo, FPS, và ping mỗi frame
    RunService.Heartbeat:Connect(function(deltaTime)
        local elapsed = os.time() - startTime
        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = elapsed % 60
        afkLabel.Text = string.format("Thời gian treo: %d giờ %d phút %d giây", hours, minutes, seconds)
        fpsLabel.Text = string.format("FPS: %d", math.floor(1 / deltaTime))
    end)

    -- Cập nhật ping mỗi giây
    spawn(function()
        while true do
            local ping = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
            pingLabel.Text = string.format("Ping: %d ms", math.floor(ping))
            wait(1)
        end
    end)

    -- Kéo thả thời gian treo, FPS, tốc độ mạng bằng chuột và cảm ứng
    local function makeDraggable(label)
        local dragging, dragInput, dragStart, startPos
        label.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = label.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)
        label.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                label.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
            end
        end)
    end

    -- Áp dụng kéo thả cho từng TextLabel
    makeDraggable(afkLabel)
    makeDraggable(fpsLabel)
    makeDraggable(pingLabel)
end
pcall(setupTimeDisplay)

