-- Phát hiện admin và hop server
local function checkAdmin()
    local adminIds = {[912348] = true, [120173604] = true}
    Players.PlayerAdded:Connect(function(player)
        if adminIds[player.UserId] then
            if player.UserId == 120173604 then
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(gameId, game.JobId, LocalPlayer)
                end)
            else
                StarterGui:SetCore("SendNotification", {
                    Title = "Cảnh Báo",
                    Text = "Admin vô server sẽ đổi server trong 5s nữa",
                    Duration = 5
                })
                wait(5)
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(gameId, game.JobId, LocalPlayer)
                end)
            end
        elseif player.Name:lower():find("admin") or player:GetRoleInGroup(game.CreatorId) ~= "Guest" then
            StarterGui:SetCore("SendNotification", {
                Title = "Cảnh Báo",
                Text = "Admin vô server sẽ đổi server trong 5s nữa",
                Duration = 5
            })
            wait(5)
            pcall(function()
                TeleportService:TeleportToPlaceInstance(gameId, game.JobId, LocalPlayer)
            end)
        end
    end)
end
pcall(checkAdmin)

-- Phát hiện player dùng hack
local function checkHackers()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            if character and character:FindFirstChild("Humanoid") and character:FindFirstChild("HumanoidRootPart") then
                local humanoid = character.Humanoid
                local rootPart = character.HumanoidRootPart
                local isHacking = humanoid.WalkSpeed > 50 or humanoid.JumpPower > 100 or rootPart.Position.Y > 500
                if isHacking then
                    local screenGui = Instance.new("ScreenGui", PlayerGui)
                    screenGui.Name = "HackWarningGui"
                    screenGui.IgnoreGuiInset = true
                    local frame = Instance.new("Frame", screenGui)
                    frame.Size = UDim2.new(0, 300, 0, 150)
                    frame.Position = UDim2.new(0.5, -150, 0.5, -75)
                    frame.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
                    frame.BackgroundTransparency = 0.5
                    local textLabel = Instance.new("TextLabel", frame)
                    textLabel.Size = UDim2.new(1, 0, 0.6, 0)
                    textLabel.BackgroundTransparency = 1
                    textLabel.Text = "Phát hiện người chơi dùng hack.\nBạn vẫn muốn chơi server này không?"
                    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                    textLabel.TextScaled = true
                    local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Sine)
                    local fadeInFrame = TweenService:Create(frame, tweenInfo, {BackgroundTransparency = 0.2})
                    local fadeInText = TweenService:Create(textLabel, tweenInfo, {TextTransparency = 0})
                    local fadeOutFrame = TweenService:Create(frame, tweenInfo, {BackgroundTransparency = 1})
                    local fadeOutText = TweenService:Create(textLabel, tweenInfo, {TextTransparency = 1})
                    fadeInFrame:Play()
                    fadeInText:Play()
                    StarterGui:SetCore("SendNotification", {
                        Title = "Cảnh Báo Hack",
                        Text = "Phát hiện người chơi dùng hack. Bạn vẫn muốn chơi server này không?",
                        Duration = 10,
                        Button1 = "Có",
                        Button2 = "Không",
                        Callback = function(state)
                            if not state then
                                StarterGui:SetCore("SendNotification", {
                                    Title = "Hop Server",
                                    Text = "Đang tìm server ít người nhất trong 10s...",
                                    Duration = 10
                                })
                                wait(10)
                                pcall(function()
                                    -- Tìm server ít người nhất (giả lập bằng cách thử hop server)
                                    local attempts = 0
                                    local maxAttempts = 5
                                    while attempts < maxAttempts do
                                        TeleportService:TeleportToPlaceInstance(gameId, game.JobId, LocalPlayer)
                                        attempts = attempts + 1
                                        wait(2)
                                    end
                                end)
                            end
                            fadeOutFrame:Play()
                            fadeOutText:Play()
                            fadeOutText.Completed:Wait()
                            screenGui:Destroy()
                        end
                    })
                    break -- Chỉ hiển thị thông báo cho hacker đầu tiên
                end
            end
        end
    end
end
RunService.Heartbeat:Connect(function()
    pcall(checkHackers)
end)

-- Fix chuyển động player
local function fixPlayerMovement()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    rootPart:SetNetworkOwner(LocalPlayer) -- Giảm latency
    humanoid.WalkSpeed = math.clamp(humanoid.WalkSpeed, 16, 50) -- Giới hạn tốc độ hợp lý
    humanoid.JumpPower = math.clamp(humanoid.JumpPower, 50, 100) -- Giới hạn nhảy hợp lý
    RunService.Stepped:Connect(function()
        if humanoid:GetState() == Enum.HumanoidStateType.Running then
            rootPart.Velocity = Vector3.new(rootPart.Velocity.X * 0.9, rootPart.Velocity.Y, rootPart.Velocity.Z * 0.9) -- Giảm giật
        end
    end)
end
pcall(fixPlayerMovement)

