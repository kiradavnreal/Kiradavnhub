local function _iA()
    local s=Instance.new("ScreenGui",_g) s.Name="IntroGui" s.IgnoreGuiInset=true
    local f=Instance.new("Frame",s) f.Size=UDim2.new(0,300,0,150) f.Position=UDim2.new(0.5,-150,0.5,-75) f.BackgroundColor3=Color3.fromRGB(0,0,0) f.BackgroundTransparency=0.5
    local t=Instance.new("TextLabel",f) t.Size=UDim2.new(1,0,0.6,0) t.BackgroundTransparency=1 t.Text="Kirada VN Hack\nTác giả: Kirada & Habato\nNgười làm & viết: Kirada & Hiếu TV" t.TextColor3=Color3.fromRGB(255,255,255) t.TextScaled=true
    local i=Instance.new("ImageLabel",f) i.Size=UDim2.new(0,100,0,100) i.Position=UDim2.new(0.5,-50,0.6,0) i.BackgroundTransparency=1 i.Image="rbxassetid://75676578090181" i.ImageTransparency=1
    local tI=TweenInfo.new(1,Enum.EasingStyle.Sine)
    local fIT,fIF,fII=_t:Create(t,tI,{TextTransparency=0}),_t:Create(f,tI,{BackgroundTransparency=0.2}),_t:Create(i,tI,{ImageTransparency=0})
    local fOT,fOF,fOI=_t:Create(t,tI,{TextTransparency=1}),_t:Create(f,tI,{BackgroundTransparency=1}),_t:Create(i,tI,{ImageTransparency=1})
    fIT:Play() fIF:Play() fII:Play() fIT.Completed:Wait() wait(5) fOT:Play() fOF:Play() fOI:Play() fOT.Completed:Wait() s:Destroy()
end
