-- Hệ thống Anti-AFK
local function startAntiAFK()
    local success, err = pcall(function()
        while true do
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(Vector2.new(0, 0)) -- Giả lập nhấn chuột trái
            task.wait(60) -- Chờ 60 giây trước khi lặp lại
        end
    end)
    if not success then
        StarterGui:SetCore("SendNotification", {
            Title = "Lỗi Anti-AFK",
            Text = "Không thể kích hoạt Anti-AFK: " .. tostring(err),
            Duration = 5
        })
    end
end
coroutine.wrap(startAntiAFK)()

-- Hệ thống Anti-Cheat cơ bản
local function setupAntiCheat()
    -- Ẩn tên script khỏi kiểm tra
    local scriptInstance = game:GetService("Players").LocalPlayer.PlayerScripts:FindFirstChild(script.Name)
    if scriptInstance then
        scriptInstance.Name = "CoreScript_" .. HttpService:GenerateGUID(false) -- Đổi tên ngẫu nhiên
    end
    -- Thêm độ trễ ngẫu nhiên cho các hành động để tránh bị phát hiện
    local function addRandomDelay()
        task.wait(math.random(0.1, 0.5))
    end
    -- Bao bọc các hành động nhạy cảm trong pcall
    local function safeExecute(func)
        local success, err = pcall(func)
        if not success then
            StarterGui:SetCore("SendNotification", {
                Title = "Lỗi Anti-Cheat",
                Text = "Lỗi khi thực thi: " .. tostring(err),
                Duration = 5
            })
        end
    end
    return addRandomDelay, safeExecute
end
local addRandomDelay, safeExecute = setupAntiCheat()

