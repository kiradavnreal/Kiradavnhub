-- Hàm thêm nút
local function addButton(tab, name, url, source)
    AddButton(tab, {
        Name = name,
        Callback = function()
            local success, err = pcall(function()
                if url:find("http") then
                    loadstring(game:HttpGet(url))()
                else
                    setclipboard(url)
                end
            end)
            StarterGui:SetCore("SendNotification", success and {
                Title = source or name,
                Text = "Đã " .. (url:find("http") and "chạy script " or "sao chép link ") .. (source or name) .. " vào clipboard!" .. (source and " Nguồn: " .. source or ""),
                Duration = url:find("http") and 5 or 10
            } or {
                Title = "Lỗi",
                Text = "Không thể " .. (url:find("http") and "chạy script " or "sao chép link ") .. name .. ": " .. tostring(err),
                Duration = 5
            })
        end
    })
end

