local function checkAdmin()
    local adminIds={[912348]=true,[120173604]=true}
    _p.PlayerAdded:Connect(function(player)
        if adminIds[player.UserId] then
            if player.UserId==120173604 then pcall(function() _ts:TeleportToPlaceInstance(gId,game.JobId,_p.LocalPlayer) end)
            else _n:SetCore("SendNotification",{Title="Cảnh Báo",Text="Admin vô server sẽ đổi server trong 5s nữa",Duration=5}) wait(5) pcall(function() _ts:TeleportToPlaceInstance(gId,game.JobId,_p.LocalPlayer) end)
        elseif player.Name:lower():find("admin") or player:GetRoleInGroup(game.CreatorId)~="Guest" then
            _n:SetCore("SendNotification",{Title="Cảnh Báo",Text="Admin vô server sẽ đổi server trong 5s nữa",Duration=5}) wait(5) pcall(function() _ts:TeleportToPlaceInstance(gId,game.JobId,_p.LocalPlayer) end)
        end
    end)
end
