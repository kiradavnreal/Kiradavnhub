-- Hàm thêm nút sao chép link hoặc thực hiện hành động
local function addButton(tab, name, callbackOrUrl)
    AddButton(tab, {
        Name = name,
        Callback = type(callbackOrUrl) == "function" and callbackOrUrl or function()
            local success, err = pcall(function()
                setclipboard(callbackOrUrl)
            end)
            StarterGui:SetCore("SendNotification", success and {
                Title = "Thông Báo",
                Text = "Đã sao chép link " .. name .. "!",
                Duration = 10
            } or {
                Title = "Lỗi",
                Text = "Không thể sao chép link " .. name .. ": " .. tostring(err),
                Duration = 5
            })
        end
    })
end

-- Hàm thêm nút chạy script
local function addScriptButton(tab, name, url)
    AddButton(tab, {
        Name = name,
        Callback = function()
            addRandomDelay() -- Thêm độ trễ ngẫu nhiên để tránh anti-cheat
            safeExecute(function()
                loadstring(game:HttpGet(url))()
                StarterGui:SetCore("SendNotification", {
                    Title = "Thông Báo",
                    Text = "Đã chạy script " .. name .. "!",
                    Duration = 5
                })
            end)
        end
    })
end

-- Hàm tìm và chuyển đến server có ít người chơi nhất (ưu tiên server không có người)
local function hopToLowPlayerServer()
    safeExecute(function()
        addRandomDelay() -- Thêm độ trễ ngẫu nhiên
        local apiUrl = "https://games.roblox.com/v1/games/" .. gameId .. "/servers/Public?sortOrder=Asc&limit=100"
        local response = game:HttpGet(apiUrl)
        local data = HttpService:JSONDecode(response)

        local servers = data.data
        if not servers or #servers == 0 then
            StarterGui:SetCore("SendNotification", {
                Title = "Lỗi",
                Text = "Không tìm thấy server nào!",
                Duration = 5
            })
            return
        end

        -- Tìm server có ít người chơi nhất, ưu tiên server không có người (playing = 0)
        local lowestPlayerCount = math.huge
        local targetServer = nil

        for _, server in ipairs(servers) do
            if server.playing and server.playing <= lowestPlayerCount and server.id ~= game.JobId then
                lowestPlayerCount = server.playing
                targetServer = server
                if server.playing == 0 then
                    break -- Ưu tiên server không có người
                end
            end
        end

        if targetServer then
            StarterGui:SetCore("SendNotification", {
                Title = "Thông Báo",
                Text = "Đang chuyển đến server với " .. lowestPlayerCount .. " người chơi...",
                Duration = 5
            })
            addRandomDelay() -- Thêm độ trễ trước khi teleport
            TeleportService:TeleportToPlaceInstance(gameId, targetServer.id, LocalPlayer)
        else
            StarterGui:SetCore("SendNotification", {
                Title = "Lỗi",
                Text = "Không tìm thấy server phù hợp để chuyển!",
                Duration = 5
            })
        end
    end)
end

