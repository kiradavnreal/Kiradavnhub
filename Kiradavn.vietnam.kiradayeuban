-- Hiển thị thời gian treo
local startTime = os.time()
local function setupTimeDisplay()
    local screenGui = Instance.new("ScreenGui", PlayerGui)
    screenGui.Name = "TimeDisplayGui"
    screenGui.IgnoreGuiInset = true

    -- Tạo TextLabel cho thời gian treo
    local afkLabel = Instance.new("TextLabel", screenGui)
    afkLabel.Size = UDim2.new(0, 200, 0, 30)
    afkLabel.Position = UDim2.new(1, -210, 0, 10)
    afkLabel.BackgroundTransparency = 0.5
    afkLabel.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    afkLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    afkLabel.TextScaled = true
    afkLabel.Text = "Thời gian treo: Đang tải..."
    afkLabel.BorderColor3 = Color3.fromRGB(255, 0, 0)
    afkLabel.BorderSizePixel = 2

    -- Cập nhật thời gian treo mỗi frame
    RunService.Heartbeat:Connect(function()
        local elapsed = os.time() - startTime
        local hours = math.floor(elapsed / 3600)
        local minutes = math.floor((elapsed % 3600) / 60)
        local seconds = elapsed % 60
        afkLabel.Text = string.format("Thời gian treo: %d giờ %d phút %d giây", hours, minutes, seconds)
    end)
end
pcall(setupTimeDisplay)

-- Chống anti-cheat
local function antiCheat()
    local mt = getrawmetatable(game)
    local namecall = mt.__namecall
    local index = mt.__index
    setreadonly(mt, false)
    -- Hook __namecall để chặn anti-cheat
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        if (method == "FireServer" or method == "InvokeServer") and (tostring(self) == "AntiCheat" or tostring(self) == "AC" or tostring(self) == "FlyDetection" or tostring(self) == "HeightCheck") then
            return
        end
        return namecall(self, ...)
    end
    -- Hook __index để random giá trị
    mt.__index = function(self, key)
        if self:IsA("Humanoid") and (key == "WalkSpeed" or key == "JumpPower" or key == "HipHeight") then
            return math.random(15, 17) + math.random()
        end
        if self:IsA("Character") and key == "Position" then
            local pos = index(self, key)
            return Vector3.new(pos.X + math.random(-0.1, 0.1), pos.Y + math.random(-0.05, 0.05), pos.Z + math.random(-0.1, 0.1))
        end
        return index(self, key)
    end
    setreadonly(mt, true)
    -- Tạo NoClip
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    PhysicsService:CreateCollisionGroup("NoClip")
    PhysicsService:CollisionGroupSetCollidable("NoClip", "Default", false)
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            PhysicsService:SetPartCollisionGroup(part, "NoClip")
        end
    end
    -- Randomize velocity để tránh phát hiện
    RunService.Heartbeat:Connect(function()
        if humanoid:GetState() == Enum.HumanoidStateType.Freefall or humanoid:GetState() == Enum.HumanoidStateType.Flying then
            rootPart.Velocity = rootPart.Velocity + Vector3.new(math.random(-1, 1)/10, math.random(-1, 1)/10, math.random(-1, 1)/10)
        end
    end)
end
pcall(antiCheat)

