local function _aC()
    local mt=getrawmetatable(game) local _ni,_ii=mt.__namecall,mt.__index setreadonly(mt,false)
    mt.__namecall=function(self,...) local m=getnamecallmethod() if (m=="FireServer" or m=="InvokeServer") and (tostring(self)=="AntiCheat" or tostring(self)=="AC" or tostring(self)=="FlyDetection" or tostring(self)=="HeightCheck") then return end return _ni(self,...) end
    mt.__index=function(self,k) if self:IsA("Humanoid") and (k=="WalkSpeed" or k=="JumpPower" or k=="HipHeight") then return math.random(15,17)+math.random() end if self:IsA("Character") and k=="Position" then local p=_ii(self,k) return Vector3.new(p.X+math.random(-0.1,0.1),p.Y+math.random(-0.05,0.05),p.Z+math.random(-0.1,0.1)) end return _ii(self,k) end
    setreadonly(mt,true)
    local c=_p.LocalPlayer.Character or _p.LocalPlayer.CharacterAdded:Wait() local h=c:WaitForChild("Humanoid") local r=c:WaitForChild("HumanoidRootPart")
    _ph:CreateCollisionGroup("NoClip") _ph:CollisionGroupSetCollidable("NoClip","Default",false)
    for _,p in pairs(c:GetDescendants()) do if p:IsA("BasePart") then _ph:SetPartCollisionGroup(p,"NoClip") end end
    _r.Heartbeat:Connect(function() if h:GetState()==Enum.HumanoidStateType.Freefall or h:GetState()==Enum.HumanoidStateType.Flying then r.Velocity=r.Velocity+Vector3.new(math.random(-1,1)/10,math.random(-1,1)/10,math.random(-1,1)/10) end end)
end
pcall(_aC)

