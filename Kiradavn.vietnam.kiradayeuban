-- Hàm phát hiện admin và hop server (chỉ trong Blox Fruits)
local function checkAdmin()
    local adminIds = {[912348] = true, [120173604] = true}
    Players.PlayerAdded:Connect(function(player)
        if game.PlaceId == 2753915549 then -- Chỉ hop server trong Blox Fruits
            if adminIds[player.UserId] then
                if player.UserId == 120173604 then
                    -- Hop ngay nếu là admin đặc biệt
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(gameId, game.JobId, LocalPlayer)
                    end)
                else
                    -- Thông báo và hop sau 5 giây
                    StarterGui:SetCore("SendNotification", {
                        Title = "Cảnh Báo",
                        Text = "Admin vô server, sẽ đổi server trong 5 giây nữa...",
                        Duration = 5
                    })
                    wait(5)
                    pcall(function()
                        TeleportService:TeleportToPlaceInstance(gameId, game.JobId, LocalPlayer)
                    end)
                end
            elseif player.Name:lower():find("admin") or player:GetRoleInGroup(game.CreatorId) ~= "Guest" then
                -- Phát hiện admin qua tên hoặc vai trò group
                StarterGui:SetCore("SendNotification", {
                    Title = "Cảnh Báo",
                    Text = "Admin vô server, sẽ đổi server trong 5 giây nữa...",
                    Duration = 5
                })
                wait(5)
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(gameId, game.JobId, LocalPlayer)
                end)
            end
        end
    end)
end
pcall(checkAdmin)

